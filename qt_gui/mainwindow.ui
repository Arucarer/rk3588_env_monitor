           <widget class="QWidget" name="settingsPage">
            <property name="styleSheet">
             <string notr="true">QWidget#settingsPage {
    background-color: rgb(245, 247, 249);
}

/* 告警阈值主卡片 */
QFrame#thresholdSettingsFrame {
    background-color: white;
    border: 1px solid rgb(220, 227, 232);
    border-radius: 8px;
}

/* 阈值输入区域 */
QWidget#thresholdFormWidget {
    background-color: rgb(248, 250, 251);
    border: 1px solid rgb(228, 233, 237);
    border-radius: 6px;
}

/* 下方系统设置卡片 */
QFrame#systemSettingsFrame {
    background-color: white;
    border: 1px solid rgb(220, 227, 232);
    border-radius: 8px;
}

/* 两个区域的标题 */
QLabel#thresholdTitleLabel,
QLabel#systemSettingsTitleLabel {
    color: rgb(31, 45, 56);
    background-color: transparent;
    border: none;
    font-size: 18px;
    font-weight: 600;
}

/* 数值输入框 */
QDoubleSpinBox {
    min-height: 28px;
    padding: 0 8px;
    color: rgb(31, 45, 56);
    background-color: white;
    border: 1px solid rgb(205, 214, 221);
    border-radius: 4px;
}

QDoubleSpinBox:focus {
    border: 1px solid rgb(36, 145, 210);
}

/* 刷新周期输入框 */
QSpinBox#refreshIntervalSpinBox {
    min-height: 28px;
    padding: 0 8px;
    background-color: white;
    border: 1px solid rgb(205, 214, 221);
    border-radius: 4px;
}

/* 保存按钮 */
QPushButton#saveSettingsButton {
    min-width: 90px;
    min-height: 32px;
    color: white;
    background-color: rgb(36, 145, 210);
    border: none;
    border-radius: 5px;
    font-weight: 600;
}

QPushButton#saveSettingsButton:hover {
    background-color: rgb(28, 125, 184);
}

QPushButton#saveSettingsButton:pressed {
    background-color: rgb(22, 105, 155);
}</string>
            </property>
